#!/usr/bin/env bash
# Tsunagu-Pad: login dari iPad pada mesin tanpa monitor (Xorg + GDM).
#
#   sudo system/tsunagupad-login-setup enable NAMA_PENGGUNA DISPLAY XAUTHORITY
#   sudo system/tsunagupad-login-setup disable
#
# enable  : Xorg selalu punya layar 1080p walau tidak ada monitor, layar login
#           GDM ikut dibagikan ke iPad, dan login otomatis dimatikan.
# disable : mengembalikan xorg.conf dan menghapus berkas di atas. Login otomatis
#           tetap mati; nyalakan sendiri di /etc/gdm3/custom.conf bila perlu.
set -euo pipefail
export LC_ALL=C
cd "$(dirname "$(readlink -f "$0")")/.."

XORG=/etc/X11/xorg.conf
EDID=/etc/X11/tsunagupad-edid.bin
STATE=/var/lib/tsunagupad
GREETER=/usr/local/lib/tsunagupad/greeter
AUTOSTART=/usr/share/gdm/greeter/autostart/tsunagupad-greeter.desktop
BEGIN='# BEGIN tsunagupad-headless'
END='# END tsunagupad-headless'

say() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
die() { echo "tsunagupad-login-setup: $*" >&2; exit 1; }

[[ $EUID -eq 0 ]] || die "jalankan lewat sudo"

read_edid() {
    # Mengeluarkan EDID biner dari output yang tersambung; gagal bila tidak valid.
    python3 -I -c '
import re, sys
m = re.search(r"^\S+ connected.*?EDID:\s*\n((?:\s+[0-9a-f]{32}\n)+)", sys.stdin.read(), re.S | re.M)
if not m:
    sys.exit("EDID tidak ditemukan; colok monitor saat menjalankan perintah ini")
b = bytes.fromhex("".join(m.group(1).split()))
if b[:8].hex() != "00ffffffffffff00" or any(sum(b[i:i + 128]) % 256 for i in range(0, len(b), 128)):
    sys.exit("EDID monitor tidak valid")
sys.stdout.buffer.write(b)
'
}

remove_xorg_block() {
    sed -i "/^${BEGIN}\$/,/^${END}\$/d" "$XORG"
}

enable() {
    local user=${1:?nama pengguna}
    local disp=${2:-} xauth=${3:-}
    local home group
    home=$(getent passwd "$user" | cut -d: -f6)
    group=$(id -gn "$user")
    local bin=$home/.local/bin/tsunagupad web=$home/.local/share/tsunagupad/web
    local token=$home/.config/tsunagupad/token

    [[ -x $bin && -d $web ]] || die "jalankan ./install.sh dulu"
    [[ -s $token ]] || die "kode akses belum ada; jalankan Tsunagu-Pad sekali dulu"
    getent passwd gdm >/dev/null || die "pengguna gdm tidak ada"
    grep -q AllowEmptyInitialConfiguration "$XORG" || die "$XORG bukan konfigurasi Tegra yang dikenali"

    if ! grep -qx "$BEGIN" "$XORG"; then
        [[ -n $disp ]] || die "DISPLAY kosong; jalankan dari terminal di sesi grafis"
        say "Menyalin EDID monitor"
        local edid_tmp output
        edid_tmp=$(mktemp)
        sudo -u "$user" env DISPLAY="$disp" XAUTHORITY="$xauth" xrandr --verbose | read_edid >"$edid_tmp"
        install -m 644 "$edid_tmp" "$EDID"
        rm -f "$edid_tmp"
        # Nama port versi driver NVIDIA (DFP-N), bukan nama RandR (DP-N).
        output=$(grep -hoE '\(DFP-[0-9]+\): connected' /var/log/Xorg.*.log | tail -n1 | grep -oE 'DFP-[0-9]+') ||
            die "port monitor tidak ditemukan di log Xorg"

        say "Membuat layar tetap untuk $output"
        [[ -e $XORG.tsunagupad.bak ]] || cp -a "$XORG" "$XORG.tsunagupad.bak"
        sed -i "/Option.*\"AllowEmptyInitialConfiguration\"/a\\
$BEGIN\\
    Option      \"ConnectedMonitor\" \"$output\"\\
    Option      \"CustomEDID\" \"$output:$EDID\"\\
$END" "$XORG"
    fi

    say "Memasang program untuk layar login"
    install -Dm755 "$bin" /usr/local/bin/tsunagupad
    install -d /usr/local/share/tsunagupad/web
    install -m644 "$web"/* /usr/local/share/tsunagupad/web/

    install -d -m 755 -o "$user" -g "$group" "$STATE"
    install -d -m 700 -o gdm -g gdm "$STATE/greeter" "$STATE/greeter/tsunagupad"
    install -m 600 -o gdm -g gdm "$token" "$STATE/greeter/tsunagupad/token"
    if [[ ! -e $STATE/enabled ]]; then
        install -m 644 -o "$user" -g "$group" /dev/null "$STATE/enabled"
    fi

    install -d "$(dirname "$GREETER")"
    cat >"$GREETER" <<'EOF'
#!/bin/sh
# Dijalankan sesi layar login GDM sebagai pengguna gdm.
[ -e /var/lib/tsunagupad/enabled ] || exit 0
export XDG_CONFIG_HOME=/var/lib/tsunagupad/greeter
# Saat logout, service sesi sebelumnya bisa masih memegang port beberapa detik.
tries=0
while [ "$tries" -lt 20 ]; do
    /usr/local/bin/tsunagupad share --quality monitor --web-dir /usr/local/share/tsunagupad/web && exit 0
    tries=$((tries + 1))
    sleep 3
done
EOF
    chmod 755 "$GREETER"
    install -d "$(dirname "$AUTOSTART")"
    cat >"$AUTOSTART" <<EOF
[Desktop Entry]
Type=Application
Name=Tsunagu-Pad login
Exec=$GREETER
NoDisplay=true
X-GNOME-Autostart-enabled=true
X-GNOME-AutoRestart=false
EOF

    say "Mematikan login otomatis"
    sed -i -E 's/^[[:space:]]*AutomaticLoginEnable[[:space:]]*=.*/AutomaticLoginEnable = false/;
               s/^[[:space:]]*AutomaticLogin[[:space:]]*=/# AutomaticLogin =/' /etc/gdm3/custom.conf

    say "Selesai. Reboot dengan monitor masih tercolok untuk mengujinya."
}

disable() {
    if [[ -f $XORG ]] && grep -qx "$BEGIN" "$XORG"; then
        remove_xorg_block
        say "Layar tetap dicabut dari $XORG"
    fi
    rm -f "$EDID" "$XORG.tsunagupad.bak" "$AUTOSTART" "$GREETER" /usr/local/bin/tsunagupad
    rm -rf /usr/local/share/tsunagupad "$STATE"
    say "Selesai. Reboot agar Xorg memakai konfigurasi semula."
}

case ${1:-} in
    enable) shift; enable "$@" ;;
    disable) disable ;;
    *) die "pemakaian: enable NAMA_PENGGUNA DISPLAY XAUTHORITY | disable" ;;
esac
