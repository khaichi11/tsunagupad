/* Sumber daya tsunagupad.exe: manifest (sadar DPI per monitor) dan info versi. */
#include <winver.h>
#include "version.h"

1 24 "tsunagupad.manifest"
1 ICON "tsunagupad.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION TSUNAGUPAD_VERSION_NUM
PRODUCTVERSION TSUNAGUPAD_VERSION_NUM
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Tsunagu-Pad"
            VALUE "FileDescription", "Tsunagu-Pad"
            VALUE "FileVersion", TSUNAGUPAD_VERSION_STR
            VALUE "InternalName", "tsunagupad"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "tsunagupad.exe"
            VALUE "ProductName", "Tsunagu-Pad"
            VALUE "ProductVersion", TSUNAGUPAD_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
